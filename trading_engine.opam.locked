opam-version: "2.0"
name: "trading_engine"
version: "~dev"
synopsis: "Deterministic event-driven trading execution engine"
description: """\
A replay-first OCaml execution engine with explicit seams for future paper
and live trading adapters. The core is a deterministic state machine with
typed order management, risk checks, simulated execution, accounting, and
an append-only audit journal."""
maintainer: "James Mallette <jamesmallmw@gmail.com>"
authors: "James Mallette <jamesmallmw@gmail.com>"
depends: [
  "alcotest" {= "1.9.1" & with-test}
  "astring" {= "0.8.5" & with-test}
  "base" {= "v0.17.3" & with-test}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "bigstringaf" {= "0.10.0"}
  "bisect_ppx" {= "dev" & with-test}
  "camlp-streams" {= "5.0.1" & with-test}
  "cmdliner" {= "2.1.1"}
  "compiler-cloning" {= "enabled"}
  "conf-gmp" {= "5"}
  "conf-pkg-config" {= "5"}
  "cppo" {= "1.8.0" & with-doc}
  "crunch" {= "4.1.0" & with-doc}
  "csexp" {= "1.5.2"}
  "cstruct" {= "6.2.0"}
  "domain-local-await" {= "1.0.1"}
  "dune" {= "3.24.2"}
  "dune-build-info" {= "3.24.2" & with-test}
  "dune-configurator" {= "3.24.2"}
  "eio" {= "1.4"}
  "eio_linux" {= "1.4"}
  "eio_main" {= "1.4"}
  "eio_posix" {= "1.4"}
  "either" {= "1.0.0" & with-test}
  "fix" {= "20250919" & with-test}
  "fmt" {= "0.11.0"}
  "fpath" {= "0.7.3" & with-test}
  "hmap" {= "0.8.1"}
  "iomux" {= "0.4"}
  "logs" {= "0.10.0"}
  "lwt-dllist" {= "1.1.0"}
  "menhir" {= "20260209" & with-test}
  "menhirCST" {= "20260209" & with-test}
  "menhirGLR" {= "20260209" & with-test}
  "menhirLib" {= "20260209" & with-test}
  "menhirSdk" {= "20260209" & with-test}
  "mtime" {= "2.2.0"}
  "ocaml" {= "5.5.0"}
  "ocaml-base-compiler" {= "5.5.0"}
  "ocaml-compiler" {= "5.5.0"}
  "ocaml-compiler-libs" {= "v0.17.0" & with-test}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0" & with-test}
  "ocaml-version" {= "4.1.3" & with-test}
  "ocaml_intrinsics_kernel" {= "v0.17.2" & with-test}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.9~preview"}
  "ocamlformat" {= "0.29.0" & with-test}
  "ocamlformat-lib" {= "0.29.0" & with-test}
  "ocp-indent" {= "1.9.0" & with-test}
  "odoc" {= "3.2.1" & with-doc}
  "odoc-parser" {= "3.2.1" & with-doc}
  "optint" {= "0.3.0"}
  "ppx_derivers" {= "1.2.1" & with-test}
  "ppxlib" {= "0.38.0" & with-test}
  "psq" {= "0.2.1"}
  "ptime" {= "1.2.0"}
  "qcheck-alcotest" {= "0.91" & with-test}
  "qcheck-core" {= "0.91" & with-test}
  "re" {= "1.14.0" & with-test}
  "seq" {= "base"}
  "sexplib0" {= "v0.17.0" & with-test}
  "stdio" {= "v0.17.0" & with-test}
  "stdlib-shims" {= "0.3.0" & with-test}
  "thread-table" {= "1.0.0"}
  "topkg" {= "1.1.1"}
  "tyxml" {= "4.6.0" & with-doc}
  "uring" {= "2.15.0"}
  "uucp" {= "17.0.0" & with-test}
  "uuseg" {= "17.0.0" & with-test}
  "uutf" {= "1.0.4" & with-test}
  "yojson" {= "3.0.0"}
  "zarith" {= "1.14"}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
license: "MIT"
homepage: "https://fallblu.github.io/trading-engine/"
bug-reports: "https://github.com/fallblu/trading-engine/issues"
